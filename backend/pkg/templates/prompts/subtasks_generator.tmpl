<plan_request>
  <instruction>
  下面是本次要处理的告警。把它拆成几条可验证的假设，用 subtask_list 提交。
  如果 known_subtasks 里有已完成的条目，先读它们的 result：已经证实的事实不要重复验证，已经被证伪的方向不要重复投入。
  </instruction>

  <alert>
    <input>{{.Task.Input}}</input>
  </alert>

  {{if .Tasks}}
  <previous_tasks>
    {{range .Tasks}}
    <task>
      <id>{{.ID}}</id>
      <input>{{.Input}}</input>
      <status>{{.Status}}</status>
      <result>{{.Result}}</result>
    </task>
    {{end}}
  </previous_tasks>
  {{end}}

  {{if .Subtasks}}
  <known_subtasks>
    {{range .Subtasks}}
    <subtask>
      <id>{{.ID}}</id>
      <title>{{.Title}}</title>
      <description>{{.Description}}</description>
      <status>{{.Status}}</status>
      <result>{{.Result}}</result>
    </subtask>
    {{end}}
  </known_subtasks>
  {{end}}
</plan_request>
