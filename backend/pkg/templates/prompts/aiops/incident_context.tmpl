{{/* 事故上下文：把一条告警渲染成模型可读的 XML。面向模型，故用中文。 */}}
<incident>
  <id>{{.Incident.ID}}</id>
  <alert>{{.Incident.AlertName}}</alert>
  <cluster>{{.Incident.Cluster}}</cluster>
  <namespace>{{.Incident.Namespace}}</namespace>
  <resource>{{.Incident.Resource}}</resource>
  <first_seen>{{.Incident.FirstSeen}}</first_seen>
  {{if .Incident.Description}}
  <description>{{.Incident.Description}}</description>
  {{end}}
  {{if .Incident.Labels}}
  <labels>
    {{range $k, $v := .Incident.Labels}}
    <label name="{{$k}}">{{$v}}</label>
    {{end}}
  </labels>
  {{end}}
</incident>

{{if .Evidence}}
<collected_evidence>
  以下证据是本次诊断已经拿到的结果，按时间排序。不要重复查询已经覆盖的时间窗与维度。
  {{range .Evidence}}
  <item source="{{.Source}}" at="{{.Timestamp}}">{{.Excerpt}}</item>
  {{end}}
</collected_evidence>
{{end}}

{{if .Findings}}
<analyst_findings>
  {{range .Findings}}
  <finding role="{{.Role}}">
    <summary>{{.Summary}}</summary>
    <confidence>{{.Confidence}}</confidence>
  </finding>
  {{end}}
</analyst_findings>
{{end}}
